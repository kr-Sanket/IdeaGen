# IdeaGen — Environment Variables
# Copy this file to .env and edit as needed.
# All variables use the IDEAGEN_ prefix.

# General
IDEAGEN_DEBUG=false
IDEAGEN_LOG_LEVEL=INFO
IDEAGEN_ENVIRONMENT=development

# Database
IDEAGEN_DATABASE_URL=postgresql+psycopg2://ideagen:ideagen_dev@localhost:5432/ideagen_db

# Providers
IDEAGEN_LLM_PROVIDER=ollama
IDEAGEN_EMBEDDING_PROVIDER=ollama

# Ollama Configuration
IDEAGEN_OLLAMA_BASE_URL=http://localhost:11434
IDEAGEN_OLLAMA_MODEL=qwen3:8b
IDEAGEN_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
IDEAGEN_OLLAMA_EMBEDDING_DIMENSION=768
IDEAGEN_OLLAMA_TIMEOUT=300.0
IDEAGEN_OLLAMA_NUM_CTX=8192
IDEAGEN_OLLAMA_AUTO_MANAGE=true
IDEAGEN_OLLAMA_IDLE_TIMEOUT=60.0
IDEAGEN_OLLAMA_STARTUP_TIMEOUT=30.0
IDEAGEN_OLLAMA_POLLING_INTERVAL=0.5
IDEAGEN_OLLAMA_BINARY_PATH=ollama

# Gemini Configuration (Optional / Preserved)
# GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-2.5-flash

# Post-ingestion evolution (defaults shown; uncomment to change)
# When enabled, each OpenAlex ingestion classifies up to MAX_CANDIDATES eligible
# opportunities (one LLM call each). A request can opt out but cannot enable it.
# IDEAGEN_ENABLE_POST_INGESTION_EVOLUTION=false
# IDEAGEN_POST_INGESTION_EVOLUTION_MAX_CANDIDATES=20
# Candidate ranking strategy: "tfidf" (default) or "fifo"; other values fail at startup.
# IDEAGEN_CANDIDATE_RANKING_STRATEGY=tfidf
